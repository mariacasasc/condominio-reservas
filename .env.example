# Postgres (used by docker-compose.yml)
POSTGRES_USER=condominio
POSTGRES_PASSWORD=condominio
POSTGRES_DB=condominio_reservas
POSTGRES_PORT=5432

# Drizzle / app connection string — must match the Postgres vars above.
DATABASE_URL=postgresql://condominio:condominio@localhost:5432/condominio_reservas

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=replace-with-a-generated-32-byte-secret
